{
  "name": "reading-todo",
  "version": "0.1.0",
  "private": true,
  "description": "Reading-to-Action System: turn reading into behavior change",
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @reading-todo/shared",
    "dev:backend": "npm run dev --workspace @reading-todo/backend",
    "dev:frontend": "npm run dev --workspace @reading-todo/frontend",
    "dev:mock": "npm run dev:mock --workspace @reading-todo/frontend",
    "test": "npm run test --workspace @reading-todo/backend",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
