// Prisma schema for the Reading-to-Action System.
// US1 implemented User, Challenge, Book. US2 (minimum) adds Note and Action.
// ActionCompletion / recurrence / progress (data-model.md) remain deferred to US3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  challenges   Challenge[]
}

model Challenge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  books       Book[]

  @@index([userId])
}

model Book {
  id            String    @id @default(uuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  title         String
  author        String
  readingReason String?
  readingStatus String    @default("to_read") // to_read | reading | done
  createdAt     DateTime  @default(now())
  notes         Note[]

  @@index([challengeId])
}

model Note {
  id        String   @id @default(uuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  actions   Action[]

  @@index([bookId])
}

model Action {
  id                String   @id @default(uuid())
  noteId            String?
  note              Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  description       String
  cadence           String // daily | weekly | monthly | one_time
  sourceNoteDeleted Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([noteId])
}
